# OpenRouter API Key (required for LLM provider)
# Format: sk-or-v1-...
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Alternative API key alias
# MVGEOS_API_KEY=your_api_key_here

# Optional: Secret key used to encrypt NiceGUI desktop session storage
# STORAGE_SECRET=generate_a_random_secret_string_here

# Optional: Custom runtime log directory and log level (DEBUG, INFO, WARNING, ERROR)
# MVGEOS_LOG_DIR=.logs
# MVGEOS_LOG_LEVEL=INFO

# Optional: Custom GUI database path
# MVGEOS_DB_PATH=~/.agents/.mvgeos/state.db

# Optional: Default spell execution timeout in milliseconds (default: 600000 = 10 minutes)
# MVGEOS_BASH_TIMEOUT_MS=600000
