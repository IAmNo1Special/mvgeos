# OpenRouter API Key (primary LLM provider)
# Format: sk-or-v1-...
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Alternative API key aliases
MVGEOS_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional: Secret key used to encrypt NiceGUI desktop session storage
STORAGE_SECRET=

# Optional: Custom runtime log directory and log level (DEBUG, INFO, WARNING, ERROR)
MVGEOS_LOG_DIR=.logs
MVGEOS_LOG_LEVEL=INFO

# Optional: Custom GUI database path (default: ~/.agents/.mvgeos/state.db)
MVGEOS_DB_PATH=

# Optional: Constrain agent file/bash operations to an authorized workspace directory
MVGEOS_WORKSPACE_ROOT=

# Optional: Default spell execution timeout in milliseconds (default: 600000 = 10 minutes)
MVGEOS_BASH_TIMEOUT_MS=600000

# Optional: External editor command for editing configurations or notes (e.g., code, vim, nano)
EDITOR=
