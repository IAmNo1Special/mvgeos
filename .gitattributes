# Normalize all text files to LF regardless of platform.
# Set core.autocrlf to something sensible below; attributes take precedence.
* text=auto

# Force LF for code, config, and documentation files.
*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.lock text eol=lf
*.gitignore text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
py.typed text eol=lf